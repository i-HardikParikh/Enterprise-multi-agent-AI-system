# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE provider: groq | gemini | ollama
LLM_PROVIDER=groq

# ── Groq (FREE - Recommended) ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (FREE - 1500 req/day) ───────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Ollama (FREE - 100% Local, no internet) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Embeddings (FREE - runs locally, no API key) ─────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE=faiss
FAISS_INDEX_PATH=./data/faiss_index
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX_NAME=enterprise-multi-agent-system

# ─── Redis (session memory) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ─── LangSmith Observability (FREE tier available) ────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=Enterprise-multi-agent-system

# ─── Langfuse Observability (Self-Hosted) ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=http://localhost:4000
LANGFUSE_DB_USER=postgres
LANGFUSE_DB_PASSWORD=your_secure_postgres_password_here
LANGFUSE_DB_NAME=langfuse
NEXTAUTH_SECRET=your_random_nextauth_secret_here
SALT=your_random_salt_here

# ─── Aegra Deployment (Self-Hosted) ───────────────────────────────────────────
AEGRA_DB_USER=postgres
AEGRA_DB_PASSWORD=your_secure_aegra_postgres_password_here
AEGRA_DB_NAME=aegra

# ─── App Config ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=3
MAX_ITERATIONS=10
DB_URL=postgresql://postgres:postgres@localhost:5434/enterprise_app

# ─── Search Tool (optional) ───────────────────────────────────────────────────
SERPAPI_API_KEY=

# ─── Authentication ────────────────────────────────────────────────────────────
# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_random_256_bit_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Static API key for service-to-service access (scripts, CI, LangGraph Studio).
# Leave blank to disable static key auth (JWT-only mode).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
